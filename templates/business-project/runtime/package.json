{
  "name": "{{PACKAGE_NAME}}",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "node .prototype-kit/business-cli.mjs check",
    "domain-evidence:validate": "node .prototype-kit/business-cli.mjs validate-domain-evidence",
    "delivery-governance:validate": "node .prototype-kit/business-cli.mjs validate-delivery-governance",
    "site:check": "pnpm delivery-governance:validate && pnpm build && node .prototype-kit/business-cli.mjs site-release-check",
    "workflow:generate": "node .prototype-kit/business-cli.mjs generate",
    "page-guides:generate": "node .prototype-kit/business-cli.mjs generate-page-guides",
    "handoff:generate": "node .prototype-kit/business-cli.mjs generate-development-handoff",
    "handoff:prompt": "node .prototype-kit/business-cli.mjs generate-development-task-prompt",
    "dev": "pnpm --dir prototype dev",
    "build": "pnpm check && pnpm --dir prototype build",
    "package:review": "pnpm build && node .prototype-kit/business-cli.mjs package-review",
    "task:context": "node .prototype-kit/business-cli.mjs task-context",
    "check:scope": "node .prototype-kit/business-cli.mjs check-scope"
  },
  "dependencies": {
    "fflate": "0.8.2"
  }
}
