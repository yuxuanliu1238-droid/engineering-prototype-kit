{
  "name": "engineering-prototype-kit",
  "version": "0.4.0",
  "private": true,
  "description": "A guided starter kit for product managers building reviewable engineering prototypes with AI.",
  "type": "module",
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "workflow:generate": "node scripts/generate-requirements.mjs",
    "project:validate": "node scripts/validate-project.mjs",
    "workflow:validate": "node scripts/validate-workflow.mjs",
    "contracts:validate": "node scripts/validate-contracts.mjs",
    "links:validate": "node scripts/validate-links.mjs",
    "skills:validate": "node scripts/validate-skills.mjs",
    "skills:test-retrospective": "node scripts/test-prototype-change-retrospective.mjs",
    "skills:test-scenario-evidence": "node scripts/test-scenario-evidence-capture.mjs",
    "skills:test-enhancements": "node scripts/test-existing-skill-enhancements.mjs",
    "skills:test-routing": "node scripts/test-orchestrator-routing.mjs",
    "review-evidence:test": "node scripts/test-review-evidence.mjs",
    "handoff:generate": "node scripts/generate-development-task-list.mjs --input examples/development-handoff-isolated.json --output examples/development-handoff-isolated.md",
    "handoff:validate": "node scripts/validate-development-handoff.mjs --input examples/development-handoff-isolated.json --expected examples/development-handoff-isolated.md",
    "handoff:test": "node scripts/test-development-handoff.mjs",
    "handoff:prompt": "node scripts/generate-development-task-prompt.mjs --input examples/development-handoff-isolated.json --task TASK-002 --context examples/development-task-context-isolated.json --output examples/development-task-prompt-isolated.md",
    "handoff:prompt-test": "node scripts/test-development-task-prompt.mjs",
    "skills:test-development-handoff": "node scripts/test-development-handoff-skill.mjs",
    "domain-evidence:test": "node scripts/test-domain-evidence.mjs",
    "delivery-governance:test": "node scripts/test-delivery-governance.mjs",
    "site-release:test": "node scripts/test-site-release.mjs",
    "governed-project:test": "node scripts/test-governed-business-project.mjs",
    "optional-material:test": "node scripts/test-optional-material-activation.mjs",
    "templates:validate": "node scripts/validate-templates.mjs",
    "project:create": "node scripts/create-project.mjs",
    "project:activate": "node scripts/activate-optional-material.mjs",
    "project:configure-handoff": "node scripts/configure-development-handoff.mjs",
    "project:switch-mode": "node scripts/switch-project-mode.mjs",
    "project:migrate": "node scripts/migrate-v02-to-v03.mjs",
    "project:upgrade": "node scripts/upgrade-project.mjs",
    "project-tools:test": "node scripts/test-project-tools.mjs",
    "example:validate": "node scripts/validate-example.mjs",
    "guardrails:test": "node scripts/test-guardrails.mjs",
    "check": "node scripts/check-current.mjs",
    "dev": "pnpm --dir prototype dev",
    "build:review": "pnpm check && pnpm --dir prototype build",
    "build:delivery": "pnpm build:kit-release",
    "build:kit-release": "pnpm build:review && pnpm package:kit-release && pnpm kit-release:validate",
    "package:release": "node scripts/package-release.mjs",
    "release:validate": "node scripts/validate-release.mjs",
    "package:kit-release": "node scripts/package-release.mjs",
    "kit-release:validate": "node scripts/validate-release.mjs",
    "hardening:test": "node scripts/test-hardening.mjs",
    "task:context": "node scripts/task-context-cli.mjs",
    "check:scope": "node scripts/check-scope-cli.mjs",
    "check:archive": "node scripts/validate-project.mjs --archive && pnpm workflow:validate && pnpm contracts:validate && pnpm links:validate && pnpm skills:validate && pnpm skills:test-retrospective && pnpm skills:test-scenario-evidence && pnpm skills:test-enhancements && pnpm skills:test-routing && pnpm skills:test-development-handoff && pnpm domain-evidence:test && pnpm delivery-governance:test && pnpm site-release:test && pnpm governed-project:test && pnpm optional-material:test && pnpm review-evidence:test && pnpm handoff:validate && pnpm handoff:test && pnpm handoff:prompt-test && pnpm templates:validate && pnpm example:validate && pnpm guardrails:test && pnpm project-tools:test",
    "check:current": "node scripts/check-current.mjs",
    "context:test": "node scripts/test-task-context.mjs",
    "checks:test": "node scripts/test-check-runner.mjs",
    "transactions:test": "node scripts/test-transactions.mjs",
    "quality:check": "node scripts/quality-metrics.mjs",
    "install:test": "node scripts/test-install.mjs",
    "browser:test": "node scripts/test-browser.mjs"
  },
  "dependencies": {
    "fflate": "0.8.2"
  }
}
